{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcbanlist",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "triggers": {
    "crons": ["17 20 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcbanlist",
      "database_id": "a7349479-d35a-401a-8f2a-e122e380b760"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e02c7063aac542a6928e8904740d2406"
    }
  ],
  "vars": {
    "GALLERIES_JSON": "[{\"id\":\"onshinproject\",\"path\":\"mgallery\"}]",
    "MAX_CRAWL_PAGES": "20",
    "MAX_CRAWL_GALLERIES": "10"
  }
}
